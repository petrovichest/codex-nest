--- /dev/null
+++ b/codex-rs/state/src/runtime/delivery_operations.rs
@@ -0,0 +1,141 @@
+//! Restart-safe receipts for accepting a command before releasing its sender.
+//! A prepared row retains the canonical write so a crash between SQLite and
+//! the rollout file can be recovered without submitting the command again.
+
+use super::SqliteQueueStore;
+use sqlx::Row;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DeliveryOperation {
+    pub operation_id: String,
+    pub request_hash: String,
+    pub request_json: Option<String>,
+    pub result_json: String,
+    pub ready: bool,
+}
+
+impl SqliteQueueStore {
+    /// Replay before opening local attachments, which may have been moved or
+    /// removed since the original queue admission.
+    pub async fn replay_enqueue(
+        &self,
+        thread_id: codex_protocol::ThreadId,
+        request_json: &str,
+    ) -> anyhow::Result<Option<crate::QueuedUserSubmissionRecord>> {
+        let request: serde_json::Value = serde_json::from_str(request_json)?;
+        let Some(client_id) = request
+            .get("UserInput")
+            .and_then(|input| input.get("client_id"))
+            .and_then(serde_json::Value::as_str)
+        else {
+            return Ok(None);
+        };
+        let Some(operation) = self
+            .read_delivery(&format!("queue:{thread_id}/{client_id}"))
+            .await?
+        else {
+            return Ok(None);
+        };
+        anyhow::ensure!(
+            operation.request_hash == request_json,
+            "client message ID has different queued input"
+        );
+        let (id, payload) = serde_json::from_str(&operation.result_json)?;
+        Ok(Some(crate::QueuedUserSubmissionRecord {
+            id,
+            thread_id,
+            payload,
+        }))
+    }
+
+    pub async fn read_delivery(
+        &self,
+        operation_id: &str,
+    ) -> anyhow::Result<Option<DeliveryOperation>> {
+        let row = sqlx::query(
+            "SELECT operation_id, request_hash, request_json, result_json, ready
+             FROM delivery_operations WHERE operation_id = ?",
+        )
+        .bind(operation_id)
+        .fetch_optional(self.pool.as_ref())
+        .await?;
+        row.map(|row| {
+            Ok(DeliveryOperation {
+                operation_id: row.try_get("operation_id")?,
+                request_hash: row.try_get("request_hash")?,
+                request_json: row.try_get("request_json")?,
+                result_json: row.try_get("result_json")?,
+                ready: row.try_get("ready")?,
+            })
+        })
+        .transpose()
+    }
+
+    /// Reserves an immutable result. Returns false when another admission owns
+    /// this ID; that caller must replay the stored receipt rather than execute.
+    pub async fn prepare_delivery(&self, operation: &DeliveryOperation) -> anyhow::Result<bool> {
+        let mut connection = self.pool.acquire().await?;
+        // This setting belongs to each pooled connection, not to the database.
+        sqlx::query("PRAGMA synchronous = FULL")
+            .execute(&mut *connection)
+            .await?;
+        let result = sqlx::query(
+            "INSERT INTO delivery_operations
+             (operation_id, request_hash, request_json, result_json, ready)
+             VALUES (?, ?, ?, ?, 0) ON CONFLICT(operation_id) DO NOTHING",
+        )
+        .bind(&operation.operation_id)
+        .bind(&operation.request_hash)
+        .bind(&operation.request_json)
+        .bind(&operation.result_json)
+        .execute(&mut *connection)
+        .await?;
+        Ok(result.rows_affected() == 1)
+    }
+
+    /// Retires the payload only after the canonical write is durable. The
+    /// compact receipt has no TTL: an arbitrarily delayed replay is still a replay.
+    pub async fn finish_delivery(&self, operation_id: &str) -> anyhow::Result<()> {
+        let mut connection = self.pool.acquire().await?;
+        sqlx::query("PRAGMA synchronous = FULL")
+            .execute(&mut *connection)
+            .await?;
+        let result = sqlx::query(
+            "UPDATE delivery_operations SET ready = 1, request_json = NULL
+             WHERE operation_id = ?",
+        )
+        .bind(operation_id)
+        .execute(&mut *connection)
+        .await?;
+        anyhow::ensure!(result.rows_affected() == 1, "missing delivery operation");
+        Ok(())
+    }
+
+    pub async fn complete_delivery(
+        &self,
+        operation_id: &str,
+        result_json: &str,
+    ) -> anyhow::Result<()> {
+        let mut connection = self.pool.acquire().await?;
+        sqlx::query("PRAGMA synchronous = FULL")
+            .execute(&mut *connection)
+            .await?;
+        let result = sqlx::query(
+            "UPDATE delivery_operations SET result_json = ?, ready = 1, request_json = NULL
+             WHERE operation_id = ? AND ready = 0",
+        )
+        .bind(result_json)
+        .bind(operation_id)
+        .execute(&mut *connection)
+        .await?;
+        anyhow::ensure!(
+            result.rows_affected() == 1,
+            "delivery completion changed concurrently"
+        );
+        Ok(())
+    }
+}
