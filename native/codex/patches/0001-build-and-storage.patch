+use super::*;
+use crate::StateRuntime;
+use crate::runtime::test_support::unique_temp_dir;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn consumed_and_canceled_queue_entries_are_not_resurrected_by_replay() {
+    let home = unique_temp_dir();
+    let config = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+    let runtime = StateRuntime::init(config, "test".into()).await.unwrap();
+    let queue = runtime.thread_queue();
+    let thread = codex_protocol::ThreadId::new();
+    let payload = r#"{"UserInput":{"content":[],"client_id":"message"}}"#;
+    let queued = queue.enqueue(thread, payload).await.unwrap();
+    let delivery = DeliveryOperation {
+        operation_id: format!("input:{thread}/message"),
+        request_hash: "intent".into(),
+        request_json: Some(payload.into()),
+        result_json: r#"{"turn_id":"turn","started":true}"#.into(),
+        ready: false,
+    };
+    queue.prepare_delivery(&delivery).await.unwrap();
+    assert!(!queue.cancel(thread, &queued.id).await.unwrap());
+    assert!(
+        queue
+            .update(thread, &queued.id, payload)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    queue.finish_delivery(&delivery.operation_id).await.unwrap();
+    assert!(queue.delete(thread, &queued.id).await.unwrap());
+    assert_eq!(queue.enqueue(thread, payload).await.unwrap(), queued);
+    assert!(queue.list_page(thread, 0, 10).await.unwrap().is_empty());
+    assert!(
+        queue
+            .enqueue(thread, &payload.replace("[]", "[1]"))
+            .await
+            .is_err()
+    );
+    let canceled_payload = payload.replace("message", "canceled");
+    let canceled = queue.enqueue(thread, &canceled_payload).await.unwrap();
+    assert!(queue.cancel(thread, &canceled.id).await.unwrap());
+    assert_eq!(
+        queue.enqueue(thread, &canceled_payload).await.unwrap(),
+        canceled
+    );
+    assert!(queue.list_page(thread, 0, 10).await.unwrap().is_empty());
+    runtime.close().await;
+}
+
+#[tokio::test]
+async fn receipt_survives_reopen_without_replacing_the_original_result() {
+    let home = unique_temp_dir();
+    let config = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+    let runtime = StateRuntime::init(config.clone(), "test".into())
+        .await
+        .unwrap();
+    let prepared = DeliveryOperation {
+        operation_id: "thread/message".into(),
+        request_hash: "original".into(),
+        request_json: Some("input".into()),
+        result_json: "turn-1".into(),
+        ready: false,
+    };
+    assert!(
+        runtime
+            .thread_queue()
+            .prepare_delivery(&prepared)
+            .await
+            .unwrap()
+    );
+    runtime.close().await;
+    let runtime = StateRuntime::init(config, "test".into()).await.unwrap();
+    assert_eq!(
+        runtime
+            .thread_queue()
+            .read_delivery(&prepared.operation_id)
+            .await
+            .unwrap(),
+        Some(prepared.clone())
+    );
+    let replacement = DeliveryOperation {
+        result_json: "turn-2".into(),
+        ..prepared.clone()
+    };
+    assert!(
+        !runtime
+            .thread_queue()
+            .prepare_delivery(&replacement)
+            .await
+            .unwrap()
+    );
+    runtime
+        .thread_queue()
+        .finish_delivery(&prepared.operation_id)
+        .await
+        .unwrap();
+    assert_eq!(
+        runtime
+            .thread_queue()
+            .read_delivery(&prepared.operation_id)
+            .await
+            .unwrap(),
+        Some(DeliveryOperation {
+            request_json: None,
+            ready: true,
+            ..prepared
+        })
+    );
+    runtime.close().await;
+}
