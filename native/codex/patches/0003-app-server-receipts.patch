diff --git a/codex-rs/app-server/src/request_processors/durable_delivery.rs b/codex-rs/app-server/src/request_processors/durable_delivery.rs
new file mode 100644
index 0000000..7b4677e
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/durable_delivery.rs
@@ -0,0 +1,214 @@
+use super::*;
+use codex_protocol::turn_input::DurableTurnInput;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+pub(super) static CREATION_LOCK: tokio::sync::Semaphore = tokio::sync::Semaphore::const_new(1);
+
+pub(super) struct DurableCreation {
+    pub state: StateDbHandle,
+    pub operation_id: String,
+    pub thread_id: ThreadId,
+    pub client_id: String,
+    pub recovering: bool,
+}
+
+pub(super) enum CreationAdmission {
+    New(DurableCreation),
+    Replay(Box<ThreadStartResponse>),
+    Unkeyed,
+}
+
+pub(super) async fn prepare_creation(
+    state: Option<&StateDbHandle>,
+    params: &ThreadStartParams,
+    thread_manager: &ThreadManager,
+) -> Result<CreationAdmission, JSONRPCErrorError> {
+    let Some(client_id) = &params.client_creation_id else {
+        return Ok(CreationAdmission::Unkeyed);
+    };
+    if params.ephemeral == Some(true) {
+        return Err(invalid_request("durable creation cannot be ephemeral"));
+    }
+    let state = state.ok_or_else(|| internal_error("durable creation requires sqlite state"))?;
+    let delivery = input_delivery(params, Some(client_id))?
+        .ok_or_else(|| internal_error("missing client delivery identity"))?;
+    let operation_id = format!("create:{client_id}");
+    let existing = state
+        .thread_queue()
+        .read_delivery(&operation_id)
+        .await
+        .map_err(|err| internal_error(format!("failed to read creation receipt: {err}")))?;
+    if let Some(existing) = existing {
+        if existing.request_hash != delivery.request_hash {
+            return Err(invalid_request(
+                "creation ID has already been used with different parameters",
+            ));
+        }
+        if existing.ready {
+            let response = serde_json::from_str(&existing.result_json)
+                .map_err(|err| internal_error(format!("invalid creation receipt: {err}")))?;
+            return Ok(CreationAdmission::Replay(Box::new(response)));
+        }
+        let thread_id = ThreadId::try_from(existing.result_json.as_str())
+            .map_err(|err| internal_error(format!("invalid reserved thread ID: {err}")))?;
+        return Ok(CreationAdmission::New(DurableCreation {
+            state: Arc::clone(state),
+            operation_id,
+            thread_id,
+            client_id: client_id.clone(),
+            recovering: true,
+        }));
+    }
+    let thread_id = thread_manager.reserve_thread_id();
+    let operation = codex_state::DeliveryOperation {
+        operation_id: operation_id.clone(),
+        request_hash: delivery.request_hash,
+        request_json: Some(delivery.request_json),
+        result_json: thread_id.to_string(),
+        ready: false,
+    };
+    if !state
+        .thread_queue()
+        .prepare_delivery(&operation)
+        .await
+        .map_err(|err| internal_error(format!("failed to prepare creation: {err}")))?
+    {
+        return Err(internal_error(
+            "creation is already being prepared; retry the same ID",
+        ));
+    }
+    Ok(CreationAdmission::New(DurableCreation {
+        state: Arc::clone(state),
+        operation_id,
+        thread_id,
+        client_id: client_id.clone(),
+        recovering: false,
+    }))
+}
+
+pub(super) fn input_delivery(
+    params: &impl Serialize,
+    client_id: Option<&str>,
+) -> Result<Option<DurableTurnInput>, JSONRPCErrorError> {
+    let Some(client_id) = client_id else {
+        return Ok(None);
+    };
+    if client_id.is_empty() || client_id.len() > 512 {
+        return Err(invalid_request("invalid client message ID"));
+    }
+    // Convert to Value first so nested request maps have a canonical key order.
+    let value = canonical_value(
+        serde_json::to_value(params).map_err(|err| internal_error(err.to_string()))?,
+    );
+    let request_json =
+        serde_json::to_string(&value).map_err(|err| internal_error(err.to_string()))?;
+    let request_hash = format!("{:x}", Sha256::digest(request_json.as_bytes()));
+    Ok(Some(DurableTurnInput {
+        request_hash,
+        request_json,
+    }))
+}
+
+fn canonical_value(value: serde_json::Value) -> serde_json::Value {
+    match value {
+        serde_json::Value::Object(values) => serde_json::Value::Object(
+            values
+                .into_iter()
+                .map(|(key, value)| (key, canonical_value(value)))
+                .collect::<std::collections::BTreeMap<_, _>>()
+                .into_iter()
+                .collect(),
+        ),
+        serde_json::Value::Array(values) => {
+            serde_json::Value::Array(values.into_iter().map(canonical_value).collect())
+        }
+        value => value,
+    }
+}
+
+pub(super) fn input_error(error: codex_protocol::error::CodexErr) -> JSONRPCErrorError {
+    let message = error.to_string();
+    let code = match error.details() {
+        codex_protocol::error::CodexErrorDetails::InvalidRequest(_) => -32602,
+        codex_protocol::error::CodexErrorDetails::Io(_) => -32081,
+        _ => -32603,
+    };
+    JSONRPCErrorError {
+        code,
+        message,
+        data: Some(serde_json::json!({
+            "delivery": if code == -32602 { "rejected" } else { "unconfirmed" },
+        })),
+    }
+}
+
+/// Release the per-thread RPC serialization queue after Core admission. An
+/// interrupt or a question answer must be able to unblock the persisted input.
+pub(super) fn defer_input_response(
+    outgoing: Arc<OutgoingMessageSender>,
+    thread: Arc<CodexThread>,
+    request_id: ConnectionRequestId,
+    client_id: String,
+    response: ClientResponsePayload,
+) {
+    tokio::spawn(async move {
+        match thread.await_input_delivery(&client_id).await {
+            Ok(()) => outgoing.send_response(request_id, response).await,
+            Err(error) => outgoing.send_error(request_id, input_error(error)).await,
+        }
+    });
+}
+
+/// A committed receipt is independent of today's thread load state, settings,
+/// model availability, or local attachments. Check it before those validations.
+pub(super) async fn replay_input(
+    state: Option<&StateDbHandle>,
+    params: &impl Serialize,
+    thread_id: &str,
+    client_id: Option<&str>,
+) -> Result<Option<codex_app_server_protocol::DeliveryReceipt>, JSONRPCErrorError> {
+    let Some(client_id) = client_id else {
+        return Ok(None);
+    };
+    let delivery = input_delivery(params, Some(client_id))?
+        .ok_or_else(|| internal_error("missing client delivery identity"))?;
+    let Some(state) = state else {
+        return Err(internal_error("durable delivery storage is unavailable"));
+    };
+    let operation_id = format!("input:{thread_id}/{client_id}");
+    let Some(operation) = state
+        .thread_queue()
+        .read_delivery(&operation_id)
+        .await
+        .map_err(|error| internal_error(format!("failed to read delivery receipt: {error}")))?
+    else {
+        return Ok(None);
+    };
+    if operation.request_hash != delivery.request_hash {
+        return Err(invalid_request(
+            "DELIVERY_CONFLICT: client message ID has different input",
+        ));
+    }
+    if !operation.ready {
+        return Ok(None);
+    }
+    let result: serde_json::Value = serde_json::from_str(&operation.result_json)
+        .map_err(|error| internal_error(format!("invalid delivery receipt: {error}")))?;
+    if let Some(error) = result.get("error").and_then(serde_json::Value::as_str) {
+        return Err(input_error(
+            codex_protocol::error::CodexErr::InvalidRequest(error.into()),
+        ));
+    }
+    let turn_id = result
+        .get("turn_id")
+        .and_then(serde_json::Value::as_str)
+        .ok_or_else(|| internal_error("delivery receipt has no turn ID"))?;
+    Ok(Some(codex_app_server_protocol::DeliveryReceipt {
+        version: 1,
+        client_id: client_id.into(),
+        thread_id: thread_id.into(),
+        turn_id: Some(turn_id.into()),
+    }))
+}
