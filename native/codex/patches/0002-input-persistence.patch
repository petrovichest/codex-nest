diff --git a/codex-rs/core/src/session/durable_input.rs b/codex-rs/core/src/session/durable_input.rs
new file mode 100644
index 0000000..b24511d
--- /dev/null
+++ b/codex-rs/core/src/session/durable_input.rs
@@ -0,0 +1,415 @@
+//! Receiver-side idempotency and the persistence barrier for user input.
+//! The session loop never waits for hooks: the submitting caller waits outside
+//! it, while normal prompt recording completes the receipt before sampling.
+
+mod answers;
+
+use super::session::Session;
+use codex_history::RolloutItem;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::turn_input::TurnInput;
+use codex_protocol::turn_input::TurnInputRequest;
+use codex_protocol::turn_input::TurnInputSubmission;
+use codex_rollout::RolloutRecorder;
+use codex_state::DeliveryOperation;
+use codex_thread_store::PersistContext;
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::sync::watch;
+
+pub(super) struct PendingDelivery {
+    turn_id: String,
+    completion: watch::Sender<Option<Result<(), String>>>,
+    answer: Option<(String, Vec<codex_protocol::user_input::UserInput>)>,
+}
+
+pub(super) struct DurableInput {
+    operation_id: String,
+    client_id: String,
+    request_hash: String,
+    request_json: String,
+    item: codex_protocol::items::UserMessageItem,
+    answer_call_id: Option<String>,
+    content: Vec<codex_protocol::user_input::UserInput>,
+}
+
+#[derive(Serialize, Deserialize)]
+struct Outcome {
+    turn_id: String,
+    started: bool,
+    #[serde(default)]
+    error: Option<String>,
+}
+
+impl Outcome {
+    fn submission(self) -> CodexResult<TurnInputSubmission> {
+        if let Some(error) = self.error {
+            return Err(CodexErr::InvalidRequest(error));
+        }
+        Ok(if self.started {
+            TurnInputSubmission::Started {
+                turn_id: self.turn_id,
+            }
+        } else {
+            TurnInputSubmission::Steered {
+                turn_id: self.turn_id,
+            }
+        })
+    }
+}
+
+impl DurableInput {
+    pub(super) fn from_request(
+        session: &Session,
+        request: &TurnInputRequest,
+    ) -> CodexResult<Option<Self>> {
+        let Some(delivery) = &request.delivery else {
+            return Ok(None);
+        };
+        let TurnInput::UserInput {
+            content,
+            client_id: Some(client_id),
+        } = &request.input
+        else {
+            return Err(CodexErr::InvalidRequest(
+                "durable input requires a client message ID".into(),
+            ));
+        };
+        if content.is_empty() || client_id.is_empty() || client_id.len() > 512 {
+            return Err(CodexErr::InvalidRequest(
+                "invalid durable user input".into(),
+            ));
+        }
+        let mut item = codex_protocol::items::UserMessageItem::new(content);
+        item.client_id = Some(client_id.clone());
+        Ok(Some(Self {
+            operation_id: operation_id(session, client_id),
+            client_id: client_id.clone(),
+            request_hash: delivery.request_hash.clone(),
+            request_json: delivery.request_json.clone(),
+            item,
+            answer_call_id: None,
+            content: content.clone(),
+        }))
+    }
+
+    pub(super) async fn replay(
+        &self,
+        session: &Session,
+        submission_id: &mut String,
+    ) -> CodexResult<Option<TurnInputSubmission>> {
+        let state = session
+            .state_db()
+            .ok_or_else(|| storage("delivery storage is unavailable"))?;
+        let Some(operation) = state
+            .thread_queue()
+            .read_delivery(&self.operation_id)
+            .await
+            .map_err(storage)?
+        else {
+            return Ok(None);
+        };
+        if operation.request_hash != self.request_hash {
+            return Err(CodexErr::InvalidRequest(
+                "DELIVERY_CONFLICT: client message ID has different input".into(),
+            ));
+        }
+        let mut outcome: Outcome = serde_json::from_str(&operation.result_json).map_err(storage)?;
+        if operation.ready
+            || session
+                .pending_deliveries
+                .lock()
+                .await
+                .contains_key(&self.client_id)
+        {
+            return outcome.submission().map(Some);
+        }
+        let expected_item_id = model_item_id(session.thread_id, &self.client_id);
+        // Only recovery reads history. The ordinary send path does no history RPC.
+        let live = session
+            .live_thread_for_persistence("recover delivery")
+            .map_err(storage)?;
+        if let Some(path) = live.local_rollout_path().await.map_err(storage)? {
+            let items = match RolloutRecorder::load_rollout_items(&path).await {
+                Ok((items, _, _)) => items,
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => Vec::new(),
+                Err(error) => return Err(error.into()),
+            };
+            let canonical = items.iter().any(|item| {
+                matches!(item,
+                RolloutItem::ResponseItem(envelope) if matches!(&envelope.item,
+                    ResponseItem::Message { id: Some(id), .. } if id == &expected_item_id))
+            });
+            let present = canonical && items.iter().any(|item| {
+                matches!(item,
+                RolloutItem::EventMsg(EventMsg::ItemCompleted(event))
+                    if event.turn_id == outcome.turn_id && matches!(&event.item, codex_protocol::items::TurnItem::UserMessage(message)
+                        if message.client_id.as_deref() == Some(&self.client_id)))
+            });
+            if present {
+                live.persist(PersistContext::Standard)
+                    .await
+                    .map_err(storage)?;
+                state
+                    .thread_queue()
+                    .finish_delivery(&self.operation_id)
+                    .await
+                    .map_err(storage)?;
+                return outcome.submission().map(Some);
+            }
+            // Recover the UI event if the process died between recording the
+            // model-visible input and its matching lifecycle event.
+            if items.iter().any(|item| {
+                matches!(item,
+                RolloutItem::ResponseItem(envelope)
+                    if matches!(&envelope.item, ResponseItem::Message { id: Some(id), .. }
+                        if id == &expected_item_id) ||
+                    matches!(&envelope.item, ResponseItem::FunctionCallOutput { call_id: Some(call_id), .. }
+                        if self.answer_call_id.as_ref() == Some(call_id)))
+            }) {
+                if self.answer_call_id.is_some() && !items.iter().any(|item| matches!(item,
+                    RolloutItem::ResponseItem(envelope) if matches!(&envelope.item,
+                        ResponseItem::Message { id: Some(id), .. } if id == &expected_item_id))) {
+                    let mut response = session.response_item_from_user_input(self.content.clone());
+                    if let ResponseItem::Message { id, .. } = &mut response {
+                        *id = Some(expected_item_id.clone());
+                    }
+                    live.append_items(&[RolloutItem::ResponseItem(codex_history::ResponseItemEnvelope::new(response))])
+                        .await.map_err(storage)?;
+                }
+                live.append_items(&[RolloutItem::EventMsg(EventMsg::ItemCompleted(
+                    codex_protocol::protocol::ItemCompletedEvent {
+                        thread_id: session.thread_id,
+                        turn_id: outcome.turn_id.clone(),
+                        item: codex_protocol::items::TurnItem::UserMessage(self.item.clone()),
+                        started_at_ms: None,
+                        completed_at_ms: crate::turn_timing::now_unix_timestamp_ms(),
+                    },
+                ))])
+                .await
+                .map_err(storage)?;
+                live.persist(PersistContext::Standard)
+                    .await
+                    .map_err(storage)?;
+                state
+                    .thread_queue()
+                    .finish_delivery(&self.operation_id)
+                    .await
+                    .map_err(storage)?;
+                return outcome.submission().map(Some);
+            }
+        }
+        if !outcome.started
+            && self.answer_call_id.is_none()
+            && session.active_turn.lock().await.is_none()
+        {
+            // An interrupted turn must not be restarted just to consume a
+            // steer. It never passed the input barrier; report a definitive
+            // rejection so the sender retains the text for a fresh submission.
+            outcome.error =
+                Some("DELIVERY_REJECTED: the turn ended before accepting this message".into());
+            state
+                .thread_queue()
+                .complete_delivery(
+                    &self.operation_id,
+                    &serde_json::to_string(&outcome).map_err(storage)?,
+                )
+                .await
+                .map_err(storage)?;
+            return outcome.submission().map(Some);
+        }
+        // No prompt was recorded, so execution has not passed its persistence
+        // barrier. Reuse the reserved turn ID rather than creating another turn.
+        *submission_id = outcome.turn_id;
+        Ok(None)
+    }
+
+    pub(super) async fn accept(
+        &self,
+        session: &Session,
+        turn_id: &str,
+        started: bool,
+    ) -> CodexResult<()> {
+        let state = session
+            .state_db()
+            .ok_or_else(|| storage("delivery storage is unavailable"))?;
+        session
+            .live_thread_for_persistence("accept delivery")
+            .map_err(storage)?;
+        let operation = DeliveryOperation {
+            operation_id: self.operation_id.clone(),
+            request_hash: self.request_hash.clone(),
+            request_json: Some(self.request_json.clone()),
+            result_json: serde_json::to_string(&Outcome {
+                turn_id: turn_id.into(),
+                started,
+                error: None,
+            })
+            .map_err(storage)?,
+            ready: false,
+        };
+        if !state
+            .thread_queue()
+            .prepare_delivery(&operation)
+            .await
+            .map_err(storage)?
+        {
+            let previous = state
+                .thread_queue()
+                .read_delivery(&self.operation_id)
+                .await
+                .map_err(storage)?
+                .ok_or_else(|| storage("missing delivery reservation"))?;
+            if previous.request_hash != operation.request_hash
+                || previous.result_json != operation.result_json
+                || previous.ready
+            {
+                return Err(storage("DELIVERY_CONFLICT: delivery reservation changed"));
+            }
+        }
+        let (completion, _) = watch::channel(None);
+        session.pending_deliveries.lock().await.insert(
+            self.client_id.clone(),
+            PendingDelivery {
+                turn_id: turn_id.into(),
+                completion,
+                answer: None,
+            },
+        );
+        Ok(())
+    }
+}
+
+impl Session {
+    pub(crate) async fn await_delivery(&self, client_id: &str) -> CodexResult<()> {
+        let receiver = self
+            .pending_deliveries
+            .lock()
+            .await
+            .get(client_id)
+            .map(|pending| pending.completion.subscribe());
+        if let Some(mut receiver) = receiver {
+            loop {
+                if let Some(result) = receiver.borrow_and_update().clone() {
+                    return result.map_err(storage);
+                }
+                receiver.changed().await.map_err(storage)?;
+            }
+        }
+        let state = self
+            .state_db()
+            .ok_or_else(|| storage("delivery storage is unavailable"))?;
+        let operation = state
+            .thread_queue()
+            .read_delivery(&operation_id(self, client_id))
+            .await
+            .map_err(storage)?
+            .ok_or_else(|| storage("missing delivery receipt"))?;
+        if !operation.ready {
+            return Err(storage(
+                "DELIVERY_UNCONFIRMED: input has not been persisted",
+            ));
+        }
+        let outcome: Outcome = serde_json::from_str(&operation.result_json).map_err(storage)?;
+        outcome.submission().map(|_| ())
+    }
+
+    pub(crate) async fn finish_input_delivery(&self, client_id: Option<&str>) -> CodexResult<()> {
+        let Some(client_id) = client_id else {
+            return Ok(());
+        };
+        if !self.pending_deliveries.lock().await.contains_key(client_id) {
+            return Ok(());
+        }
+        let result = async {
+            self.try_ensure_rollout_materialized(PersistContext::Standard)
+                .await?;
+            let state = self
+                .state_db()
+                .ok_or_else(|| storage("delivery storage is unavailable"))?;
+            state
+                .thread_queue()
+                .finish_delivery(&operation_id(self, client_id))
+                .await
+                .map_err(storage)
+        }
+        .await;
+        if let Some(pending) = self.pending_deliveries.lock().await.remove(client_id) {
+            pending.completion.send_replace(Some(
+                result.as_ref().map(|_| ()).map_err(ToString::to_string),
+            ));
+        }
+        result
+    }
+
+    pub(crate) async fn reject_input_delivery(&self, client_id: Option<&str>) -> CodexResult<()> {
+        let Some(client_id) = client_id else {
+            return Ok(());
+        };
+        if !self.pending_deliveries.lock().await.contains_key(client_id) {
+            return Ok(());
+        }
+        let state = self
+            .state_db()
+            .ok_or_else(|| storage("delivery storage is unavailable"))?;
+        let id = operation_id(self, client_id);
+        let operation = state
+            .thread_queue()
+            .read_delivery(&id)
+            .await
+            .map_err(storage)?
+            .ok_or_else(|| storage("missing delivery reservation"))?;
+        let mut outcome: Outcome = serde_json::from_str(&operation.result_json).map_err(storage)?;
+        let message = "DELIVERY_REJECTED: input was blocked by a user-prompt hook";
+        outcome.error = Some(message.into());
+        state
+            .thread_queue()
+            .complete_delivery(&id, &serde_json::to_string(&outcome).map_err(storage)?)
+            .await
+            .map_err(storage)?;
+        if let Some(pending) = self.pending_deliveries.lock().await.remove(client_id) {
+            pending.completion.send_replace(Some(Err(message.into())));
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn interrupt_pending_deliveries(&self, turn_id: &str) {
+        self.pending_deliveries.lock().await.retain(|_, pending| {
+            if pending.turn_id != turn_id {
+                return true;
+            }
+            pending.completion.send_replace(Some(Err(
+                "DELIVERY_UNCONFIRMED: turn ended before input persistence".into(),
+            )));
+            false
+        });
+    }
+}
+
+fn operation_id(session: &Session, client_id: &str) -> String {
+    format!("input:{}/{client_id}", session.thread_id)
+}
+
+fn storage(error: impl std::fmt::Display) -> CodexErr {
+    if error.to_string().starts_with("DELIVERY_REJECTED:") {
+        return CodexErr::InvalidRequest(error.to_string());
+    }
+    CodexErr::Io(std::io::Error::other(format!("durable delivery: {error}")))
+}
+
+/// Keep recovery markers valid Responses API message IDs for every client ID.
+pub(super) fn model_item_id(
+    thread_id: codex_protocol::ThreadId,
+    client_id: &str,
+) -> codex_protocol::ResponseItemId {
+    codex_protocol::ResponseItemId::with_suffix(
+        "msg",
+        uuid::Uuid::new_v5(
+            &uuid::Uuid::NAMESPACE_OID,
+            format!("codex-delivery:{thread_id}/{client_id}").as_bytes(),
+        ),
+    )
+}
diff --git a/codex-rs/core/src/session/durable_input/answers.rs b/codex-rs/core/src/session/durable_input/answers.rs
new file mode 100644
index 0000000..ec46043
--- /dev/null
+++ b/codex-rs/core/src/session/durable_input/answers.rs
@@ -0,0 +1,193 @@
+//! Bind a saved answer to its original native question and persistence barrier.
+
+use super::*;
+
+impl Session {
+    pub(crate) async fn cancel_pending_user_input(&self, turn_id: &str) {
+        let turn_state = {
+            let active = self.active_turn.lock().await;
+            active
+                .as_ref()
+                .map(|active| std::sync::Arc::clone(&active.turn_state))
+        };
+        if let Some(turn_state) = turn_state {
+            turn_state.lock().await.remove_pending_user_input(turn_id);
+        }
+    }
+
+    pub(crate) async fn prepare_durable_user_response(
+        self: &std::sync::Arc<Self>,
+        request: TurnInputRequest,
+        turn_id: &str,
+        call_id: &str,
+        response: codex_protocol::request_user_input::RequestUserInputResponse,
+    ) -> CodexResult<()> {
+        let mut delivery = DurableInput::from_request(self, &request)?
+            .ok_or_else(|| CodexErr::InvalidRequest("a client message ID is required".into()))?;
+        delivery.answer_call_id = Some(call_id.into());
+        let mut reserved_turn = turn_id.to_owned();
+        if delivery.replay(self, &mut reserved_turn).await?.is_some() {
+            return Ok(());
+        }
+        let turn_state = {
+            let active = self.active_turn.lock().await;
+            match active.as_ref() {
+                Some(active) => {
+                    if active
+                        .task
+                        .as_ref()
+                        .is_none_or(|task| task.turn_context.sub_id != turn_id)
+                    {
+                        return Err(CodexErr::InvalidRequest(
+                            "the question is no longer pending in this turn".into(),
+                        ));
+                    }
+                    Some(std::sync::Arc::clone(&active.turn_state))
+                }
+                None => None,
+            }
+        };
+        if let Some(turn_state) = turn_state {
+            // Claim the waiter atomically with question validation, then release
+            // both turn locks before storage I/O. A concurrent interrupt remains
+            // possible; a closed waiter yields no delivery acknowledgement.
+            let waiter = {
+                let mut state = turn_state.lock().await;
+                if !state.has_pending_user_input(turn_id, call_id) {
+                    return Err(CodexErr::InvalidRequest(
+                        "the question is no longer pending in this turn".into(),
+                    ));
+                }
+                state
+                    .remove_pending_user_input(turn_id)
+                    .ok_or_else(|| storage("question waiter disappeared"))?
+            };
+            delivery.accept(self, turn_id, /*started*/ false).await?;
+            if let Some(pending) = self
+                .pending_deliveries
+                .lock()
+                .await
+                .get_mut(&delivery.client_id)
+            {
+                pending.answer = Some((call_id.into(), delivery.content));
+            }
+            if waiter
+                .send(crate::state::AcceptedUserInputResponse {
+                    response,
+                    acceptance_order: self.reserve_user_input_order().await,
+                })
+                .is_err()
+            {
+                self.interrupt_pending_deliveries(turn_id).await;
+                return Err(storage(
+                    "question was interrupted before receiving the answer",
+                ));
+            }
+            return Ok(());
+        }
+        let live = self
+            .live_thread_for_persistence("recover question response")
+            .map_err(storage)?;
+        let path = live
+            .local_rollout_path()
+            .await
+            .map_err(storage)?
+            .ok_or_else(|| CodexErr::InvalidRequest("question history is unavailable".into()))?;
+        let (items, _, _) = RolloutRecorder::load_rollout_items(&path).await?;
+        let mut current_turn = None;
+        let mut question_exists = false;
+        let mut answered = false;
+        for item in &items {
+            match item {
+                RolloutItem::EventMsg(EventMsg::TurnStarted(event)) => {
+                    current_turn = Some(event.turn_id.as_str())
+                }
+                RolloutItem::ResponseItem(envelope) => match &envelope.item {
+                    ResponseItem::FunctionCall {
+                        call_id: id, name, ..
+                    } if id == call_id
+                        && name == "request_user_input"
+                        && current_turn == Some(turn_id) =>
+                    {
+                        question_exists = true
+                    }
+                    ResponseItem::FunctionCallOutput {
+                        call_id: Some(id), ..
+                    } if id == call_id => answered = true,
+                    _ => {}
+                },
+                _ => {}
+            }
+        }
+        if !question_exists || answered {
+            return Err(CodexErr::InvalidRequest(
+                "the question is unavailable or already answered".into(),
+            ));
+        }
+        // The native process died before recording a previously admitted answer.
+        // Restore the answer in the interrupted turn's context without starting
+        // another model run or repeating tools.
+        let (context, _) = self
+            .new_turn_with_sub_id(turn_id.into(), Default::default(), Default::default())
+            .await?;
+        delivery.accept(self, turn_id, /*started*/ false).await?;
+        let output = ResponseItem::FunctionCallOutput {
+            id: None,
+            call_id: Some(call_id.into()),
+            name: None,
+            namespace: None,
+            output: codex_protocol::models::FunctionCallOutputPayload {
+                body: codex_protocol::models::FunctionCallOutputBody::Text(
+                    serde_json::to_string(&response).map_err(storage)?,
+                ),
+                success: Some(true),
+            },
+            internal_chat_message_metadata_passthrough: None,
+        };
+        self.record_conversation_items(&context, &[output]).await;
+        self.record_user_prompt_and_emit_turn_item(
+            &context,
+            &delivery.content,
+            Some(delivery.client_id.clone()),
+            None,
+            PersistContext::Standard,
+        )
+        .await;
+        self.finish_input_delivery(Some(&delivery.client_id)).await
+    }
+
+    pub(crate) async fn finish_answer_delivery(
+        &self,
+        context: &crate::session::turn_context::TurnContext,
+        call_id: Option<&str>,
+    ) -> CodexResult<()> {
+        let Some(call_id) = call_id else {
+            return Ok(());
+        };
+        let deliveries = self
+            .pending_deliveries
+            .lock()
+            .await
+            .iter()
+            .filter_map(|(client_id, pending)| {
+                pending
+                    .answer
+                    .as_ref()
+                    .filter(|(id, _)| id == call_id)
+                    .map(|(_, item)| (client_id.clone(), item.clone()))
+            })
+            .collect::<Vec<_>>();
+        for (client_id, content) in deliveries {
+            self.record_user_prompt_and_emit_turn_item(
+                context,
+                &content,
+                Some(client_id.clone()),
+                None,
+                PersistContext::Standard,
+            )
+            .await;
+            self.finish_input_delivery(Some(&client_id)).await?;
+        }
+        Ok(())
+    }
+}
