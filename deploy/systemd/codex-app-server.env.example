# Authenticated HTTP proxy read by deploy/systemd/codex-proxied.
# Save as ~/.config/codex/app-server.env with mode 0600. The wrapper refuses to
# start Codex when any variant is missing or points at a different proxy.
HTTPS_PROXY=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
HTTP_PROXY=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
ALL_PROXY=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
NO_PROXY=localhost,127.0.0.1,::1

# Some Codex dependencies read lowercase variants.
https_proxy=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
http_proxy=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
all_proxy=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT
no_proxy=localhost,127.0.0.1,::1
