{
  "name": "codexnest",
  "version": "0.1.6",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run build -w @codexnest/protocol && concurrently -k -n server,client -c blue,green \"npm run dev -w @codexnest/server\" \"npm run dev -w @codexnest/client\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run build -w @codexnest/protocol && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "protocol:generate": "npm run protocol:generate -w @codexnest/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
