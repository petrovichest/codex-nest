{
  "name": "@codexnest/extension",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@codexnest/protocol": "0.1.9"
  },
  "scripts": {
    "dev": "vite build --mode chrome --watch",
    "version:check": "node scripts/check-version.mjs",
    "build": "npm run build -w @codexnest/protocol && npm run version:check && tsc -b && npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "lint:firefox": "npx --yes web-ext@10.6.0 lint --source-dir dist/firefox --warnings-as-errors",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test --config=playwright.config.ts",
    "package": "node scripts/package.mjs",
    "package:chrome": "node scripts/package.mjs chrome",
    "package:firefox": "node scripts/package.mjs firefox",
    "package:build": "npm run build && npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/ws": "^8.18.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
