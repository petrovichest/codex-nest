<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Arbitrary LAN IP/domain is selected at runtime, so cleartext cannot be scoped to a build-time domain. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
